<section class="page-width auth auth--password">
  <div class="auth__card">
    <p class="eyebrow">{{ settings.biz_name }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'form' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}<p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
      <label>{{ 'newsletter.label' | t }}<input type="email" name="contact[email]" required></label>
      <button type="submit" class="btn btn--accent">{{ 'newsletter.button' | t }}</button>
    {%- endform -%}
    <details class="auth__owner">
      <summary class="small">{{ 'general.password_owner' | t }}</summary>
      {%- form 'storefront_password', class: 'form' -%}
        {{ form.errors | default_errors }}
        <label>{{ 'customer.fields.password' | t }}<input type="password" name="password" autocomplete="current-password"></label>
        <button type="submit" class="btn btn--primary">{{ 'customer.login.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "La boutique Escale VR ouvre bientôt" }
  ]
}
{% endschema %}
