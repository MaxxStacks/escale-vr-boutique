<section class="section">
  <div class="page-width">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="link-arrow">{{ section.settings.link_label }} {%- render 'icon', name: 'arrow' -%}</a>
      {%- endif -%}
    </div>
    <ul class="tiles tiles--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <li class="tile" {{ block.shopify_attributes }}>
          <a href="{{ c.url | default: '#' }}" class="tile__link">
            <span class="tile__media">
              {%- assign img = block.settings.image | default: c.featured_image -%}
              {%- if img -%}
                {{ img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 16vw, 45vw', alt: c.title | default: block.settings.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="tile__title">{{ block.settings.title | default: c.title }}</span>
            {%- if c.products_count > 0 -%}<span class="tile__count">{{ 'sections.collection.products_count' | t: count: c.products_count }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collection tiles",
  "tag": "div",
  "class": "section-tiles",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Magasiner par catégorie" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trouvez la bonne pièce pour votre VR" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Toutes les catégories" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "default": "6", "options": [{ "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }] }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [{ "name": "Collection tiles", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
