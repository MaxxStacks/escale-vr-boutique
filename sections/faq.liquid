{%- comment -%}
  FAQ accordion. Emits FAQPage JSON-LD (answer engines / AI Overviews quote these directly).
  Keep answers factual and self-contained: each answer should make sense when quoted alone.
{%- endcomment -%}
<section class="section faq">
  <div class="page-width faq__inner">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section__sub">{{ section.settings.text }}</div>{%- endif -%}
      <a href="tel:{{ settings.biz_phone_e164 }}" class="btn btn--primary">{%- render 'icon', name: 'phone' -%} {{ settings.biz_phone }}</a>
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary><h3 class="accordion__title">{{ block.settings.question }}</h3>{%- render 'icon', name: 'plus' -%}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.emit_schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions fréquentes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tout savoir avant de commander" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Une question sur une pièce ou la compatibilité avec votre VR? Notre comptoir des pièces vous répond.</p>" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": true },
    { "type": "checkbox", "id": "emit_schema", "label": "Output FAQPage structured data", "default": true, "info": "Only enable on ONE FAQ section per page." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Expédiez-vous partout au Canada?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Oui. Toutes les commandes sont expédiées depuis notre entrepôt de Beaumont (Québec) partout au Canada. La livraison est gratuite à partir de 150 $ avant taxes.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Puis-je récupérer ma commande en magasin?", "answer": "<p>Oui, la cueillette est gratuite au 12, rue de la Chute à Beaumont, à la sortie 337 de l'autoroute 20. Vous recevez un courriel dès que votre commande est prête.</p>" } },
        { "type": "question", "settings": { "question": "Comment savoir si une pièce est compatible avec mon VR?", "answer": "<p>Chaque fiche indique le numéro de pièce du fabricant et la compatibilité connue. En cas de doute, appelez notre comptoir des pièces avec la marque, le modèle et l'année de votre VR : on valide avant l'expédition.</p>" } },
        { "type": "question", "settings": { "question": "Comment suivre ma commande?", "answer": "<p>Créez un compte client pour voir vos commandes en attente, expédiées et livrées, avec le numéro de suivi du transporteur. Le lien de suivi est aussi envoyé par courriel.</p>" } },
        { "type": "question", "settings": { "question": "Quelle est votre politique de retour?", "answer": "<p>Les pièces neuves non installées peuvent être retournées dans les 30 jours dans leur emballage d'origine. Les pièces électriques installées et les articles en liquidation finale ne sont pas repris.</p>" } }
      ]
    }
  ]
}
{% endschema %}
