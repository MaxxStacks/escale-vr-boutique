<section class="page-width auth">
  <div class="auth__card">
    <h1 class="h2">{{ 'customer.activate.title' | t }}</h1>
    <p class="muted">{{ 'customer.activate.subtext' | t }}</p>
    {%- form 'activate_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <label>{{ 'customer.fields.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label>{{ 'customer.fields.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--accent btn--block">{{ 'customer.activate.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--ghost btn--block">{{ 'customer.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Activate account", "tag": "div", "class": "section-activate", "settings": [] }
{% endschema %}
