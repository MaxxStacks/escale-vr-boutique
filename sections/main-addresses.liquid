{%- paginate customer.addresses by 10 -%}
<section class="page-width account">
  <a href="{{ routes.account_url }}" class="link small">← {{ 'customer.order.back' | t }}</a>
  <div class="account__head">
    <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
    <button type="button" class="btn btn--accent" data-toggle-target="AddressNew">{{ 'customer.addresses.add' | t }}</button>
  </div>

  <div id="AddressNew" class="panel" hidden>
    <h2 class="h4">{{ 'customer.addresses.add' | t }}</h2>
    {%- form 'customer_address', customer.new_address, class: 'form' -%}
      {%- render 'address-fields', form: form, id: 'new' -%}
      <label class="check"><input type="checkbox" name="address[default]" value="1"><span>{{ 'customer.addresses.set_default' | t }}</span></label>
      <button type="submit" class="btn btn--accent">{{ 'customer.addresses.save' | t }}</button>
    {%- endform -%}
  </div>

  <ul class="addresses" role="list">
    {%- for address in customer.addresses -%}
      <li class="panel">
        {%- if address == customer.default_address -%}<p class="eyebrow">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
        <p>{{ address | format_address }}</p>
        <div class="addresses__actions">
          <button type="button" class="btn btn--ghost btn--sm" data-toggle-target="AddressEdit-{{ address.id }}">{{ 'customer.addresses.edit' | t }}</button>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" data-confirm="{{ 'customer.addresses.delete_confirm' | t }}">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="link small">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </div>
        <div id="AddressEdit-{{ address.id }}" hidden>
          {%- form 'customer_address', address, class: 'form' -%}
            {%- render 'address-fields', form: form, id: address.id -%}
            <label class="check"><input type="checkbox" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %}><span>{{ 'customer.addresses.set_default' | t }}</span></label>
            <button type="submit" class="btn btn--accent">{{ 'customer.addresses.save' | t }}</button>
          {%- endform -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
  {%- render 'pagination', paginate: paginate -%}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Addresses", "tag": "div", "class": "section-addresses", "settings": [] }
{% endschema %}
