{%- paginate search.results by section.settings.per_page -%}
<section class="collection">
  <div class="collection__banner">
    <div class="page-width collection__banner-inner">
      <h1 class="h1">{%- if search.performed -%}{{ 'sections.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'sections.search.title' | t }}{%- endif -%}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="hero__search hero__search--inline">
        <label for="SearchPage" class="visually-hidden">{{ 'sections.search.label' | t }}</label>
        {%- render 'icon', name: 'search' -%}
        <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'sections.search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="btn btn--accent">{{ 'sections.search.submit' | t }}</button>
      </form>
    </div>
  </div>

  {%- if search.performed -%}
    <div class="page-width collection__layout" data-collection>
      <aside class="collection__sidebar" data-facets-drawer>
        {%- render 'facets', results: search, url: routes.search_url -%}
      </aside>
      <div class="collection__main">
        <div class="toolbar">
          <button type="button" class="btn btn--ghost toolbar__filter" data-facets-open>{%- render 'icon', name: 'filter' -%} {{ 'sections.filters.title' | t }}</button>
          <p class="toolbar__count muted" role="status">{{ 'sections.search.count' | t: count: search.results_count }}</p>
          <div class="toolbar__sort">
            <label for="SortBy" class="small muted">{{ 'sections.filters.sort' | t }}</label>
            <select id="SortBy" name="sort_by" form="FacetsForm" data-sort>
              {%- for option in search.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == search.sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        </div>
        {%- if search.results_count == 0 -%}
          <div class="empty-state">
            <p class="h4">{{ 'sections.search.no_results' | t: terms: search.terms }}</p>
            <p class="muted">{{ 'sections.collection.empty_help' | t: phone: settings.biz_phone }}</p>
            <a href="{{ pages['demande-de-piece'].url | default: routes.collections_url }}" class="btn btn--accent">{{ 'sections.search.request_part' | t }}</a>
          </div>
        {%- else -%}
          <ul class="grid grid--products grid--4" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {%- render 'product-card', product: item, lazy: true -%}
                {%- else -%}
                  <a href="{{ item.url }}" class="card card--text"><span class="eyebrow">{{ item.object_type }}</span><h3 class="card__title">{{ item.title }}</h3><p class="muted small">{{ item.content | strip_html | truncatewords: 20 }}</p></a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "class": "section-main-search",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
