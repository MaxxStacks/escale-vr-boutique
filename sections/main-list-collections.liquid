<section class="page-width section">
  {%- render 'breadcrumbs' -%}
  <h1 class="h1">{{ section.settings.heading }}</h1>
  <ul class="tiles tiles--4">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' or c.handle == 'all' -%}
        <li class="tile">
          <a href="{{ c.url }}" class="tile__link">
            <span class="tile__media">
              {%- if c.featured_image -%}
                {{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: c.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="tile__title">{{ c.title }}</span>
            <span class="tile__count">{{ 'sections.collection.products_count' | t: count: c.products_count }}</span>
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Toutes les catégories de pièces VR" }
  ]
}
{% endschema %}
