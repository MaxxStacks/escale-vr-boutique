{%- paginate blog.articles by 12 -%}
<section class="page-width section">
  {%- render 'breadcrumbs' -%}
  <h1 class="h1">{{ blog.title }}</h1>
  <ul class="grid grid--3 articles" role="list">
    {%- for article in blog.articles -%}
      <li>
        <article class="card card--article">
          <a href="{{ article.url }}" class="card__media ratio ratio--wide" tabindex="-1" aria-hidden="true">
            {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt | default: article.title }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder' }}{%- endif -%}
          </a>
          <div class="card__body">
            <p class="card__vendor"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time></p>
            <h2 class="card__title h4"><a href="{{ article.url }}" class="link-cover">{{ article.title }}</a></h2>
            <p class="muted small">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
          </div>
        </article>
      </li>
    {%- endfor -%}
  </ul>
  {%- render 'pagination', paginate: paginate -%}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "tag": "div", "class": "section-main-blog", "settings": [] }
{% endschema %}
