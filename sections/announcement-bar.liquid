{%- if section.blocks.size > 0 -%}
<div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}" {{ section.shopify_attributes }}>
  <div class="page-width announcement__inner">
    <div class="announcement__messages" data-rotator>
      {%- for block in section.blocks -%}
        <p class="announcement__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
    <div class="announcement__aside">
      {%- if section.settings.show_phone -%}
        <a href="tel:{{ settings.biz_phone_e164 }}" class="announcement__phone">{%- render 'icon', name: 'phone' -%}<span>{{ settings.biz_phone }}</span></a>
      {%- endif -%}
      {%- if section.settings.show_main_site -%}
        <a href="{{ settings.main_site_url }}" class="announcement__site">{{ 'sections.announcement.main_site' | t }}</a>
      {%- endif -%}
      {%- render 'localization-switcher', id: 'AnnouncementLocalization' -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement",
  "max_blocks": 4,
  "settings": [
    { "type": "checkbox", "id": "show_phone", "label": "Show phone", "default": true },
    { "type": "checkbox", "id": "show_main_site", "label": "Show link back to escalevr.ca", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Livraison gratuite au Canada dès 150 $ · Cueillette gratuite à Beaumont" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
