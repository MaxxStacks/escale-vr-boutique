<section class="page-width cart-page">
  <h1 class="h1">{{ 'sections.cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <p class="h4">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent">{{ 'sections.cart.continue' | t }}</a>
      {%- unless customer -%}<p class="muted">{{ 'sections.cart.login_prompt_html' | t: url: routes.account_login_url }}</p>{%- endunless -%}
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid" id="CartForm">
      <div>
        <table class="cart-table">
          <thead><tr><th>{{ 'sections.cart.product' | t }}</th><th>{{ 'products.product.quantity' | t }}</th><th class="ta-right">{{ 'sections.cart.total' | t }}</th></tr></thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-table__product">
                    {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 96, height: 96, alt: item.title | escape }}{%- endif -%}
                    <div>
                      <a href="{{ item.url }}" class="line-item__title">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}<p class="muted small">{{ item.variant.title }}</p>{%- endunless -%}
                      {%- if item.sku != blank -%}<p class="muted small">{{ 'products.product.part_number' | t }} : {{ item.sku }}</p>{%- endif -%}
                      <p class="small">{%- render 'money', amount: item.final_price -%}</p>
                    </div>
                  </div>
                </td>
                <td>
                  <label for="Updates-{{ forloop.index }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
                  <input id="Updates-{{ forloop.index }}" class="qty__input qty__input--boxed" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                  <a href="{{ item.url_to_remove }}" class="link small">{{ 'sections.cart.remove' | t }}</a>
                </td>
                <td class="ta-right"><strong>{%- render 'money', amount: item.final_line_price -%}</strong></td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        <button type="submit" name="update" class="btn btn--ghost">{{ 'sections.cart.update' | t }}</button>
      </div>
      <aside class="cart-summary">
        <label for="CartNote" class="small">{{ 'sections.cart.note' | t }}</label>
        <textarea id="CartNote" name="note" rows="3" placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
        <div class="cart-drawer__total"><span>{{ 'sections.cart.subtotal' | t }}</span><strong>{%- render 'money', amount: cart.total_price, style: 'currency' -%}</strong></div>
        <p class="muted small">{{ 'sections.cart.taxes_note' | t }}</p>
        <button type="submit" name="checkout" class="btn btn--accent btn--block btn--lg">{{ 'sections.cart.checkout' | t }}</button>
        {%- if additional_checkout_buttons -%}<div class="cart-summary__dynamic">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
      </aside>
    </form>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart", "tag": "div", "class": "section-main-cart", "settings": [] }
{% endschema %}
