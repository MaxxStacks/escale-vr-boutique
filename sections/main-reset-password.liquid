<section class="page-width auth">
  <div class="auth__card">
    <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <label>{{ 'customer.fields.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label>{{ 'customer.fields.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button type="submit" class="btn btn--accent btn--block">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "tag": "div", "class": "section-reset", "settings": [] }
{% endschema %}
