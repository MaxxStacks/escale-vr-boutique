<section class="recommendations" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width recommendations__inner">
      <div class="section__head"><h2 class="h3">{{ section.settings.heading }}</h2></div>
      <ul class="grid grid--products grid--4" role="list">
        {%- for product in recommendations.products -%}
          <li>{%- render 'product-card', product: product, lazy: true -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "section-recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Souvent achetés ensemble" },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [{ "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" }] },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
