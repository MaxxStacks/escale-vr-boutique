<section class="section partners">
  <div class="page-width">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="section__sub">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>
    <ul class="partners__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="partner">
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', width: 180, alt: block.settings.name }}
            {%- else -%}
              <span class="partner__name">{{ block.settings.name }}</span>
            {%- endif -%}
            <span class="partner__desc">{{ block.settings.description }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand partners",
  "tag": "div",
  "class": "section-partners",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nos partenaires" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Des dizaines de milliers de pièces sur commande" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Grâce à nos ententes avec les plus grands distributeurs nord-américains, on trouve la pièce qu'il vous faut, même si elle n'est pas en tablette.</p>" }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Partenaire" },
        { "type": "text", "id": "description", "label": "Short description" },
        { "type": "url", "id": "link", "label": "Link (collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand partners",
      "blocks": [
        { "type": "partner", "settings": { "name": "Meyer Distributing", "description": "Accessoires VR et camionnettes" } },
        { "type": "partner", "settings": { "name": "NTP-STAG", "description": "Pièces et accessoires VR" } },
        { "type": "partner", "settings": { "name": "Keystone Automotive", "description": "Remorquage et équipement" } },
        { "type": "partner", "settings": { "name": "Atlas Trailer", "description": "Pièces de remorque et d'essieux" } }
      ]
    }
  ]
}
{% endschema %}
