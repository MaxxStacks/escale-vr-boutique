<section class="section partners">
  <div class="page-width">
    <div class="section__head section__head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="section__sub">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>
    <ul class="partners__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign logo_asset = block.settings.logo_asset | strip
          assign brand_url = block.settings.link
          if brand_url == blank
            assign brand_url = block.settings.name | url_for_vendor
          endif
          assign has_logo = false
          if block.settings.logo != blank or logo_asset != blank
            assign has_logo = true
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ brand_url }}" class="partner{% if has_logo %} partner--logo{% endif %}">
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 480 | image_tag: loading: 'lazy', width: 240, height: 100, alt: block.settings.name }}
            {%- elsif logo_asset != blank -%}
              <img src="{{ logo_asset | asset_url }}" alt="{{ block.settings.name | escape }}" width="240" height="100" loading="lazy">
            {%- else -%}
              <span class="partner__name">{{ block.settings.name }}</span>
            {%- endif -%}
            {%- if block.settings.description != blank -%}<span class="partner__desc">{{ block.settings.description }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brand partners",
  "tag": "div",
  "class": "section-partners",
  "max_blocks": 15,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nos marques" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Les grandes marques du VR, au comptoir des pièces" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pièces d'origine et accessoires des fabricants en qui nos techniciens ont confiance.</p>" }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Monochrome logo on a transparent background, 12:5 ratio (e.g. 480 × 200 px)." },
        { "type": "text", "id": "logo_asset", "label": "Built-in logo file", "info": "Used when no logo is uploaded, e.g. brand-dometic.png" },
        { "type": "text", "id": "name", "label": "Brand name (exact product vendor)", "default": "Marque" },
        { "type": "text", "id": "description", "label": "Short description" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to all products from this brand." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand partners",
      "blocks": [
        { "type": "partner", "settings": { "name": "GE Appliances", "logo_asset": "brand-ge.png" } },
        { "type": "partner", "settings": { "name": "Dometic", "logo_asset": "brand-dometic.png" } },
        { "type": "partner", "settings": { "name": "Furrion", "logo_asset": "brand-furrion.png" } },
        { "type": "partner", "settings": { "name": "Thetford", "logo_asset": "brand-thetford.png" } },
        { "type": "partner", "settings": { "name": "Dicor", "logo_asset": "brand-dicor.png" } }
      ]
    }
  ]
}
{% endschema %}
