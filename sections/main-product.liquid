{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign part_number = product.metafields.custom.part_number.value
  assign compat = product.metafields.custom.compatibility
  assign specs = product.metafields.custom.specifications
  comment
    Rich-text specs are written as a bulleted list of "<strong>Label</strong> : value" items; split them
    so they can feed the key-spec cards and the spec table. Index 0 is the markup before the first <li>.
  endcomment
  assign spec_items = ''
  if specs != blank
    assign spec_items = specs | metafield_tag | split: '<li>'
  endif
  assign cond = product.metafields.custom.condition.value
  assign is_plan = false
  if section.settings.layout == 'plan'
    assign is_plan = true
  endif
  assign plan_features = product.metafields.custom.plan_features.value
  assign is_liquidation = false
  if product.tags contains 'liquidation' or product.tags contains 'Liquidation'
    assign is_liquidation = true
  endif
  assign saving = 0
  if current_variant.compare_at_price > current_variant.price
    assign saving = current_variant.compare_at_price | minus: current_variant.price
    assign saving_pct = saving | times: 100.0 | divided_by: current_variant.compare_at_price | round
    assign saving_money = saving | money
  endif
  assign contact_url = pages['nous-joindre'].url | default: '/pages/nous-joindre'
  assign pickups = current_variant.store_availabilities | where: 'pick_up_enabled', true
  case cond
    when 'used'
      assign cond_key = 'products.condition.used'
    when 'refurbished'
      assign cond_key = 'products.condition.refurbished'
    else
      assign cond_key = 'products.condition.new'
  endcase
-%}
<section class="product page-width{% if is_plan %} product--plan{% endif %}" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  {%- render 'breadcrumbs' -%}

  <div class="product__grid">
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="product__gallery{% if product.media.size > 1 %} product__gallery--thumbs{% endif %}" data-gallery>
      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.product.media_n' | t: n: forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: '' }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="gallery__thumb-play">▶</span>{%- endif -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="gallery__main">
        <div class="gallery__track" data-gallery-track>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <figure class="gallery__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- liquid
                      assign loading = 'lazy'
                      assign priority = 'auto'
                      if forloop.first
                        assign loading = 'eager'
                        assign priority = 'high'
                      endif
                    -%}
                    {{ media | image_url: width: 1400 | image_tag: loading: loading, fetchpriority: priority, widths: '550, 750, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title }}
                    <button type="button" class="gallery__zoom" data-zoom="{{ media | image_url: width: 2400 }}" aria-label="{{ 'products.product.zoom' | t }}">{%- render 'icon', name: 'zoom' -%}</button>
                  {%- when 'video', 'external_video' -%}
                    {{ media | media_tag: image_size: '1400x' }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            <figure class="gallery__slide gallery__slide--empty">{%- render 'category-icon', handle: product.type, title: product.type -%}</figure>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="gallery__dots" aria-hidden="true">
            {%- for media in product.media -%}<span class="gallery__dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------- Buy box ---------- {%- endcomment -%}
    <div class="product__info">
      <div class="product__badges">
        {%- if is_liquidation -%}<span class="badge badge--sale">{{ 'products.badges.liquidation' | t }}</span>{%- endif -%}
        {%- if saving > 0 -%}<span class="badge badge--sale-soft">{{ 'products.product.save_pct' | t: pct: saving_pct }}</span>{%- endif -%}
        {%- if is_plan -%}<span class="badge">{{ 'products.badges.plan' | t }}</span>{%- endif -%}
      </div>

      {%- if product.vendor != blank -%}
        <p class="product__vendor">{{ product.vendor | link_to_vendor }}</p>
      {%- endif -%}
      <h1 class="product__title">{{ product.title }}</h1>

      <dl class="product__ids">
        {%- unless is_plan -%}
          <div class="product__id">
            <dt>{{ 'products.product.part_number' | t }}</dt>
            <dd><span data-sku>{{ part_number | default: current_variant.sku | default: '—' }}</span>
              <button type="button" class="product__copy" data-copy-sku aria-label="{{ 'products.product.copy' | t }}">{%- render 'icon', name: 'copy' -%}</button>
            </dd>
          </div>
        {%- endunless -%}
        {%- if product.type != blank -%}<div class="product__id"><dt>{{ 'products.product.category' | t }}</dt><dd>{{ product.type }}</dd></div>{%- endif -%}
        {%- unless is_plan -%}<div class="product__id"><dt>{{ 'products.product.condition' | t }}</dt><dd>{{ cond_key | t }}</dd></div>{%- endunless -%}
      </dl>

      {%- if spec_items.size > 1 -%}
        <ul class="key-specs" role="list" aria-label="{{ 'products.tabs.specifications' | t }}">
          {%- for item in spec_items offset: 1 limit: 4 -%}
            {%- assign row = item | split: '</li>' | first | split: '</strong>' -%}
            <li>
              <span class="key-specs__label">{{ row.first | strip_html | strip }}</span>
              <span class="key-specs__value">{{ row.last | strip_html | remove_first: ':' | strip }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="product__price" data-price-wrap>
        {%- render 'price', product: product, variant: current_variant, size: 'lg' -%}
        {%- if saving > 0 -%}
          <p class="product__saving">{{ 'products.product.you_save' | t: amount: saving_money }}</p>
        {%- endif -%}
        <p class="small muted">{{ 'products.product.taxes_note' | t }}</p>
      </div>

      {%- if is_plan and plan_features -%}
        <div class="plan-box">
          <p class="plan-box__title">{{ 'products.plan.included' | t }}</p>
          <ul class="plan__features">
            {%- for f in plan_features -%}<li>{%- render 'icon', name: 'check' -%}<span>{{ f }}</span></li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'product-form', id: 'ProductForm', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <div class="variants" data-variant-picker>
            {%- for option in product.options_with_values -%}
              <fieldset class="variants__option">
                <legend>{{ option.name }}&nbsp;: <strong data-option-selected="{{ forloop.index0 }}">{{ option.selected_value }}</strong></legend>
                <div class="variants__values">
                  {%- for value in option.values -%}
                    <label class="pill">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
          <script type="application/json" data-variants-json>
            {{ product.variants | json }}
          </script>
        {%- endunless -%}

        <div class="product__availability">
          <p class="stock" data-stock>
            {%- if is_plan -%}
              <span class="stock__dot"></span>{{ 'products.product.plan_available' | t }}
            {%- elsif current_variant.available -%}
              {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= 0 -%}
                <span class="stock__dot stock__dot--warn"></span>{{ 'products.product.backorder' | t }}
              {%- elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity <= section.settings.low_stock -%}
                <span class="stock__dot stock__dot--warn"></span>{{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
              {%- else -%}
                <span class="stock__dot"></span>{{ 'products.product.in_stock' | t }}
              {%- endif -%}
            {%- else -%}
              <span class="stock__dot stock__dot--out"></span>{{ 'products.product.out_of_stock' | t }}
            {%- endif -%}
          </p>
          {%- unless is_plan -%}
            <p class="product__eta">{%- render 'icon', name: 'clock' -%} {{ 'products.product.eta' | t: days: settings.handling_days }}</p>
            {%- if pickups.size > 0 -%}
              <p class="product__eta">{%- render 'icon', name: 'store' -%} {{ 'products.product.pickup_at' | t: location: pickups.first.location.name, time: pickups.first.pick_up_time }}</p>
            {%- endif -%}
          {%- endunless -%}
        </div>

        <div class="product-form__buy">
          {%- unless is_plan -%}
            <div class="qty">
              <button type="button" class="qty__btn" data-qty-step="-1" aria-label="{{ 'products.product.decrease' | t }}">{%- render 'icon', name: 'minus' -%}</button>
              <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
              <input id="Quantity-{{ section.id }}" class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" class="qty__btn" data-qty-step="1" aria-label="{{ 'products.product.increase' | t }}">{%- render 'icon', name: 'plus' -%}</button>
            </div>
          {%- endunless -%}
          <button type="submit" name="add" class="btn btn--accent btn--lg product-form__submit" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
            {%- render 'icon', name: 'cart' -%}
            <span data-add-label>{%- if current_variant.available -%}{% if is_plan %}{{ 'products.product.book_plan' | t }}{% else %}{{ 'products.product.add_to_cart' | t }}{% endif %}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
          </button>
        </div>
        {%- if section.settings.show_dynamic_checkout -%}
          <div class="product-form__dynamic">{{ form | payment_button }}</div>
        {%- endif -%}
        <p class="form-error" role="alert" data-form-error hidden></p>
      {%- endform -%}

      {%- unless is_plan -%}
        <div class="fit-box">
          <p class="fit-box__title">{%- render 'icon', name: 'check' -%} {{ 'products.fit.title' | t }}</p>
          {%- if compat != blank -%}
            <div class="fit-box__compat rte">{{ compat | metafield_tag }}</div>
          {%- endif -%}
          <p class="small muted">{{ 'products.fit.text' | t }}</p>
          <a href="{{ contact_url }}?piece={{ product.title | append: ' — ' | append: current_variant.sku | url_encode }}" class="link small">{{ 'products.fit.cta' | t }} →</a>
        </div>
      {%- endunless -%}

      <ul class="product__assurances" role="list">
        {%- if is_plan -%}
          <li>{%- render 'icon', name: 'calendar' -%}<span><strong>{{ 'products.assurances.plan_booking_title' | t }}</strong>{{ 'products.assurances.plan_booking' | t }}</span></li>
          <li>{%- render 'icon', name: 'wrench' -%}<span><strong>{{ 'products.assurances.plan_techs_title' | t }}</strong>{{ 'products.assurances.plan_techs' | t }}</span></li>
        {%- else -%}
          <li>{%- render 'icon', name: 'truck' -%}<span><strong>{{ 'products.assurances.shipping_title' | t }}</strong>{{ 'products.assurances.shipping' | t: threshold: settings.free_shipping_threshold }}</span></li>
          {%- if settings.pickup_enabled -%}<li>{%- render 'icon', name: 'store' -%}<span><strong>{{ 'products.assurances.pickup_title' | t }}</strong>{{ 'products.assurances.pickup' | t }}</span></li>{%- endif -%}
          <li>{%- render 'icon', name: 'return' -%}<span><strong>{{ 'products.assurances.returns_title' | t }}</strong>{{ 'products.assurances.returns' | t: days: settings.return_days }}</span></li>
        {%- endif -%}
        <li>{%- render 'icon', name: 'shield' -%}<span><strong>{{ 'products.assurances.secure_title' | t }}</strong>{{ 'products.assurances.secure' | t }}</span></li>
      </ul>

      <div class="expert-card">
        <span class="expert-card__icon">{%- render 'icon', name: 'wrench' -%}</span>
        <div>
          <p class="expert-card__title">{{ 'products.expert.title' | t }}</p>
          <p class="small muted">{{ 'products.expert.text' | t }}</p>
        </div>
        <a href="tel:{{ settings.biz_phone_e164 }}" class="btn btn--primary btn--sm">{%- render 'icon', name: 'phone' -%} {{ settings.biz_phone }}</a>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Details tabs ---------- {%- endcomment -%}
  <div class="product-tabs" data-tabs>
    <div class="product-tabs__bar" role="tablist">
      <button type="button" role="tab" class="product-tabs__btn is-active" aria-selected="true" aria-controls="tab-desc-{{ section.id }}" data-tab>{{ 'products.tabs.description' | t }}</button>
      <button type="button" role="tab" class="product-tabs__btn" aria-selected="false" aria-controls="tab-specs-{{ section.id }}" data-tab>{{ 'products.tabs.specifications' | t }}</button>
      {%- unless is_plan -%}
        <button type="button" role="tab" class="product-tabs__btn" aria-selected="false" aria-controls="tab-compat-{{ section.id }}" data-tab>{{ 'products.tabs.compatibility' | t }}</button>
        <button type="button" role="tab" class="product-tabs__btn" aria-selected="false" aria-controls="tab-ship-{{ section.id }}" data-tab>{{ 'products.tabs.shipping' | t }}</button>
      {%- endunless -%}
    </div>
    <div class="product-tabs__panel rte" role="tabpanel" id="tab-desc-{{ section.id }}">
      <h2 class="visually-hidden">{{ 'products.tabs.description' | t }}</h2>
      {%- if product.description != blank -%}{{ product.description }}{%- else -%}<p class="muted">{{ 'products.tabs.no_description' | t }}</p>{%- endif -%}
    </div>
    <div class="product-tabs__panel" role="tabpanel" id="tab-specs-{{ section.id }}" hidden>
      <h2 class="visually-hidden">{{ 'products.tabs.specifications' | t }}</h2>
      <table class="spec-table">
        <tbody>
          {%- if product.vendor != blank -%}<tr><th>{{ 'products.specs.brand' | t }}</th><td>{{ product.vendor }}</td></tr>{%- endif -%}
          {%- unless is_plan -%}<tr><th>{{ 'products.product.part_number' | t }}</th><td data-sku>{{ part_number | default: current_variant.sku | default: '—' }}</td></tr>{%- endunless -%}
          {%- if current_variant.barcode != blank -%}<tr><th>{{ 'products.specs.barcode' | t }}</th><td>{{ current_variant.barcode }}</td></tr>{%- endif -%}
          {%- if product.type != blank -%}<tr><th>{{ 'products.product.category' | t }}</th><td>{{ product.type }}</td></tr>{%- endif -%}
          {%- unless is_plan -%}<tr><th>{{ 'products.product.condition' | t }}</th><td>{{ cond_key | t }}</td></tr>{%- endunless -%}
          {%- for item in spec_items offset: 1 -%}
            {%- assign row = item | split: '</li>' | first | split: '</strong>' -%}
            <tr><th>{{ row.first | strip_html | strip }}</th><td>{{ row.last | strip_html | remove_first: ':' | strip }}</td></tr>
          {%- endfor -%}
          {%- if current_variant.weight > 0 -%}<tr><th>{{ 'products.specs.weight' | t }}</th><td>{{ current_variant.weight | weight_with_unit }}</td></tr>{%- endif -%}
        </tbody>
      </table>
      {%- if specs != blank and spec_items.size <= 1 -%}<div class="rte spec-extra">{{ specs | metafield_tag }}</div>{%- endif -%}
    </div>
    {%- unless is_plan -%}
      <div class="product-tabs__panel rte" role="tabpanel" id="tab-compat-{{ section.id }}" hidden>
        <h2 class="visually-hidden">{{ 'products.tabs.compatibility' | t }}</h2>
        {%- if compat != blank -%}{{ compat | metafield_tag }}{%- else -%}<p>{{ 'products.fit.none' | t: phone: settings.biz_phone }}</p>{%- endif -%}
      </div>
      <div class="product-tabs__panel rte" role="tabpanel" id="tab-ship-{{ section.id }}" hidden>
        <h2 class="visually-hidden">{{ 'products.tabs.shipping' | t }}</h2>
        {%- if section.settings.shipping_page != blank -%}
          {{ section.settings.shipping_page.content }}
        {%- else -%}
          <p>{{ 'products.tabs.shipping_default' | t: threshold: settings.free_shipping_threshold, days: settings.return_days }}</p>
        {%- endif -%}
      </div>
    {%- endunless -%}
  </div>

  <div class="sticky-atc" data-sticky-atc hidden>
    <div class="page-width sticky-atc__inner">
      {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', width: 44, height: 44, alt: '', class: 'sticky-atc__img' }}{%- endif -%}
      <span class="sticky-atc__title">{{ product.title }}</span>
      <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
      <button type="submit" form="ProductForm" class="btn btn--accent" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.product.add_short' | t }}</button>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox>
    <button type="button" class="lightbox__close btn btn--icon" data-lightbox-close aria-label="{{ 'general.close' | t }}">{%- render 'icon', name: 'close' -%}</button>
    <img alt="{{ product.title | escape }}" width="1600" height="1600" data-lightbox-img>
  </dialog>
</section>

{%- render 'schema-product' -%}

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "part", "options": [
      { "value": "part", "label": "Part / accessory" },
      { "value": "plan", "label": "Service plan" }
    ] },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay / dynamic checkout", "default": true },
    { "type": "range", "id": "low_stock", "label": "Low stock warning at", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "page", "id": "shipping_page", "label": "Shipping & returns page (tab content)" }
  ]
}
{% endschema %}
