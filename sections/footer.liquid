{%- liquid
  assign main_url = settings.main_site_url | default: 'https://escalevr.ca'
  assign link_cols = 0
  for block in section.blocks
    unless block.type == 'hours'
      assign link_cols = link_cols | plus: 1
    endunless
  endfor
  # PayPal is not offered for now; fall back to the configured card list when nothing else is reported.
  assign pay_types = ''
  for type in shop.enabled_payment_types
    unless type == 'paypal'
      assign pay_types = pay_types | append: type | append: ','
    endunless
  endfor
  if pay_types == blank
    assign pay_types = settings.payment_icons | remove: ' '
  endif
  assign pay_types = pay_types | split: ','
-%}
<footer class="footer">
  {%- if section.settings.show_trust -%}
    <div class="footer__trust">
      <ul class="page-width footer__trust-list" role="list">
        <li>{%- render 'icon', name: 'truck' -%}<span><strong>{{ 'footer.trust_shipping' | t: threshold: settings.free_shipping_threshold }}</strong><small>{{ 'footer.trust_shipping_sub' | t }}</small></span></li>
        <li>{%- render 'icon', name: 'store' -%}<span><strong>{{ 'footer.trust_pickup' | t }}</strong><small>{{ settings.biz_city }}, {{ 'footer.trust_pickup_sub' | t }}</small></span></li>
        <li>{%- render 'icon', name: 'wrench' -%}<span><strong>{{ 'footer.trust_experts' | t }}</strong><small>{{ 'footer.trust_experts_sub' | t }}</small></span></li>
        <li>{%- render 'icon', name: 'shield' -%}<span><strong>{{ 'footer.trust_secure' | t }}</strong><small>{{ 'footer.trust_secure_sub' | t }}</small></span></li>
      </ul>
    </div>
  {%- endif -%}

  {%- if section.settings.show_newsletter -%}
    <div class="footer__newsletter">
      <div class="page-width footer__newsletter-inner">
        <div>
          <h2 class="h3">{{ 'newsletter.heading' | t }}</h2>
          <p>{{ 'newsletter.text' | t }}</p>
        </div>
        {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,boutique">
          <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="FooterNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
          <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          <p class="newsletter-form__legal">{{ 'newsletter.legal' | t }}</p>
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width footer__grid" style="--footer-cols: {{ link_cols }}">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="footer__logo-link">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', width: 180, class: 'footer__logo', alt: settings.biz_name }}
        {%- else -%}
          <img src="{{ 'escale-logo-light.png' | asset_url }}" class="footer__logo" width="180" height="61" alt="{{ settings.biz_name }}" loading="lazy">
        {%- endif -%}
      </a>
      <p class="footer__about">{{ 'footer.about' | t }}</p>
      <p class="footer__ship">{%- render 'icon', name: 'truck' -%}<span>{{ 'footer.ship_line' | t }}</span></p>
      <address class="footer__nap">
        <span>{%- render 'icon', name: 'store' -%}<span>{{ settings.biz_street }}<br>{{ settings.biz_city }} ({{ 'general.province_quebec' | t }}) {{ settings.biz_postal }}<br><small>{{ 'footer.exit' | t }}</small></span></span>
        <a href="tel:{{ settings.biz_phone_e164 }}">{%- render 'icon', name: 'phone' -%}<span>{{ settings.biz_phone }}</span></a>
        <a href="mailto:{{ settings.biz_email }}">{%- render 'icon', name: 'globe' -%}<span>{{ settings.biz_email }}</span></a>
      </address>
      <ul class="footer__social" role="list">
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank" aria-label="Facebook">{%- render 'icon', name: 'facebook' -%}</a></li>{%- endif -%}
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank" aria-label="Instagram">{%- render 'icon', name: 'instagram' -%}</a></li>{%- endif -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__col footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <details class="footer__acc" open>
              <summary class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}{%- render 'icon', name: 'chevron' -%}</summary>
              <ul role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          {%- when 'site' -%}
            <details class="footer__acc" open>
              <summary class="footer__heading">{{ block.settings.heading | default: settings.biz_name | default: 'Escale VR' }}{%- render 'icon', name: 'chevron' -%}</summary>
              <ul role="list">
                <li><a href="{{ main_url }}/acheter/">{{ 'utility.new_rvs' | t }}</a></li>
                <li><a href="{{ main_url }}/vr-occasion/">{{ 'utility.used_rvs' | t }}</a></li>
                <li><a href="{{ main_url }}/louer-un-vr/">{{ 'utility.rental' | t }}</a></li>
                <li><a href="{{ main_url }}/notre-service/">{{ 'utility.service' | t }}</a></li>
                <li><a href="{{ main_url }}/financement/">{{ 'utility.financing' | t }}</a></li>
                <li><a href="{{ main_url }}/entreprise/">{{ 'footer.about_us' | t }}</a></li>
              </ul>
            </details>
          {%- when 'hours' -%}
            {%- render 'parts-hours', style: 'footer' -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      <div class="footer__copy">
        <img src="{{ 'escale-logo-light.png' | asset_url }}" class="footer__bottom-logo" width="65" height="22" alt="{{ settings.biz_name }}" loading="lazy">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.biz_legal_name | append: '.' | replace: '..', '.' }} {{ 'general.rights' | t }} · <a href="{{ main_url }}">escalevr.ca</a></p>
      </div>
      <ul class="footer__policies" role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in pay_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- render 'localization-switcher', id: 'FooterLocalization' -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Footer logo (leave empty for the official white logo)" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust strip", "default": true },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "paragraph", "content": "All footer text is translated through the theme language files (FR/EN)." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "site",
      "name": "Escale VR links",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Escale VR" },
        { "type": "paragraph", "content": "Links to the dealership site (new and used RVs, rentals, service, financing). The base URL is set in Theme settings." }
      ]
    },
    {
      "type": "hours",
      "name": "Parts department hours",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Hours are set in Theme settings → Business info." }
      ]
    }
  ]
}
{% endschema %}
