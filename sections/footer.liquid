<footer class="footer">
  {%- if section.settings.show_newsletter -%}
    <div class="footer__newsletter">
      <div class="page-width footer__newsletter-inner">
        <div>
          <h2 class="h3">{{ section.settings.newsletter_heading }}</h2>
          <p>{{ section.settings.newsletter_text }}</p>
        </div>
        {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,boutique">
          <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="FooterNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
          <button type="submit" class="btn btn--accent">{{ 'newsletter.button' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width footer__grid">
    <div class="footer__brand">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', width: 180, class: 'footer__logo', alt: settings.biz_name }}
      {%- else -%}
        <p class="footer__wordmark">{{ settings.biz_name }}</p>
      {%- endif -%}
      <p class="footer__about">{{ section.settings.about }}</p>
      <address class="footer__nap">
        <strong>{{ settings.biz_legal_name }}</strong><br>
        {{ settings.biz_street }}<br>
        {{ settings.biz_city }} ({{ 'general.province_quebec' | t }}) {{ settings.biz_postal }}<br>
        <a href="tel:{{ settings.biz_phone_e164 }}">{{ settings.biz_phone }}</a><br>
        <a href="mailto:{{ settings.biz_email }}">{{ settings.biz_email }}</a>
      </address>
      <ul class="footer__social">
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank" aria-label="Facebook">{%- render 'icon', name: 'facebook' -%}</a></li>{%- endif -%}
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank" aria-label="Instagram">{%- render 'icon', name: 'instagram' -%}</a></li>{%- endif -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <h2 class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'hours' -%}
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <p class="footer__hours">{{ settings.biz_hours | newline_to_br }}</p>
            {%- if settings.pickup_enabled -%}<p class="footer__note">{%- render 'icon', name: 'store' -%} {{ 'general.pickup_note' | t }}</p>{%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="page-width footer__bottom-inner">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.biz_legal_name }}. {{ 'general.rights' | t }}</p>
      <ul class="footer__policies">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- render 'localization-switcher', id: 'FooterLocalization' -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Footer logo (light version)" },
    { "type": "textarea", "id": "about", "label": "Short description", "default": "La boutique en ligne d'Escale VR, concessionnaire de véhicules récréatifs à Beaumont depuis plus de 35 ans. Pièces, accessoires et plans d'entretien pour roulottes, caravanes et motorisés, expédiés partout au Canada." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Les aubaines avant tout le monde" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Liquidations, arrivages et rappels d'entretien saisonniers. Pas de pourriel, promis." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "hours",
      "name": "Hours",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Comptoir des pièces" }
      ]
    }
  ]
}
{% endschema %}
