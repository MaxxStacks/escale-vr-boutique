{%- assign c = section.settings.collection -%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow{% if section.settings.eyebrow_hot %} eyebrow--hot{% endif %}">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: c.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="section__sub">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if c != blank -%}
        <a href="{{ c.url }}" class="link-arrow">{{ 'sections.collection.view_all' | t }} {%- render 'icon', name: 'arrow' -%}</a>
      {%- endif -%}
    </div>
    <ul class="grid grid--products grid--{{ section.settings.columns }}" role="list">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          <li>{%- render 'product-card', product: product, lazy: true -%}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>
            <article class="card card--product">
              <div class="card__media ratio ratio--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
              <div class="card__body"><p class="card__vendor">Marque</p><h3 class="card__title">Produit exemple</h3><div class="price"><span class="price__current">49,99 $</span></div></div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "class": "section-featured",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jusqu'à épuisement des stocks" },
    { "type": "checkbox", "id": "eyebrow_hot", "label": "Highlight eyebrow (sale color)", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Liquidation de pièces VR" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }] },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
