{%- paginate collection.products by section.settings.per_page -%}
{%- liquid
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<section class="collection">
  <div class="collection__banner{% if collection.image and section.settings.show_image %} collection__banner--image{% endif %}">
    {%- if collection.image and section.settings.show_image -%}
      {{ collection.image | image_url: width: 1920 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920', sizes: '100vw', class: 'collection__banner-img', alt: collection.image.alt | default: collection.title }}
    {%- endif -%}
    <div class="page-width collection__banner-inner">
      {%- render 'breadcrumbs' -%}
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank and paginate.current_page == 1 -%}
        <div class="collection__intro rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="page-width collection__layout" data-collection>
    <aside class="collection__sidebar" data-facets-drawer>
      {%- render 'facets', results: collection, url: collection.url -%}
    </aside>

    <div class="collection__main">
      <div class="toolbar">
        <button type="button" class="btn btn--ghost toolbar__filter" data-facets-open>
          {%- render 'icon', name: 'filter' -%} {{ 'sections.filters.title' | t }}{% if active_count > 0 %} ({{ active_count }}){% endif %}
        </button>
        <p class="toolbar__count muted" role="status">{{ 'sections.collection.products_count' | t: count: collection.products_count }}</p>
        <div class="toolbar__sort">
          <label for="SortBy" class="small muted">{{ 'sections.filters.sort' | t }}</label>
          <select id="SortBy" name="sort_by" form="FacetsForm" data-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>

      {%- if active_count > 0 -%}
        <ul class="active-filters">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <li><a href="{{ value.url_to_remove }}" class="chip">{{ value.label | escape }} {%- render 'icon', name: 'close' -%}</a></li>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value or filter.max_value.value -%}
                <li><a href="{{ filter.url_to_remove }}" class="chip">{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} {%- render 'icon', name: 'close' -%}</a></li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <li><a href="{{ collection.url }}?sort_by={{ sort_by }}" class="link small">{{ 'sections.filters.clear' | t }}</a></li>
        </ul>
      {%- endif -%}

      {%- if collection.products.size == 0 -%}
        <div class="empty-state">
          <p class="h4">{{ 'sections.collection.empty' | t }}</p>
          <p class="muted">{{ 'sections.collection.empty_help' | t: phone: settings.biz_phone }}</p>
          <a href="{{ collection.url }}" class="btn btn--primary">{{ 'sections.filters.clear' | t }}</a>
        </div>
      {%- else -%}
        <ul class="grid grid--products grid--{{ section.settings.columns }}" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign lazy = true
              if forloop.index <= 4
                assign lazy = false
              endif
            -%}
            <li>{%- render 'product-card', product: product, lazy: lazy -%}</li>
          {%- endfor -%}
        </ul>
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}

      {%- assign seo_bottom = collection.metafields.custom.description_bottom -%}
      {%- if seo_bottom != blank and paginate.current_page == 1 -%}
        <div class="collection__seo rte">{{ seo_bottom | metafield_tag }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": {{ request.origin | append: collection.url | json }},
  {%- if collection.description != blank %}"description": {{ collection.description | strip_html | truncate: 300 | json }},{% endif %}
  "isPartOf": { "@id": {{ request.origin | append: '/#website' | json }} },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products -%}
      { "@type": "ListItem", "position": {{ paginate.current_offset | plus: forloop.index }}, "url": {{ request.origin | append: product.url | json }}, "name": {{ product.title | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image in banner", "default": true },
    { "type": "paragraph", "content": "SEO: write the collection description (top, short) in the admin. For a long-form SEO block below the grid, create a collection metafield custom.description_bottom (rich text)." }
  ]
}
{% endschema %}
