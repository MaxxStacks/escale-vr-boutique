{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
  {%- render 'css-variables' -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="page-width auth">
    <div class="auth__card">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="h2">{{ 'gift_card.title' | t }}</h1>
      <p class="h1">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-error">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
      <p>{{ 'gift_card.code' | t }}&nbsp;: <strong>{{ gift_card.code | format_code }}</strong></p>
      {%- if gift_card.expires_on -%}<p class="muted small">{{ 'gift_card.expires_on' | t: date: gift_card.expires_on }}</p>{%- endif -%}
      <a href="{{ shop.url }}" class="btn btn--accent">{{ 'gift_card.shop' | t }}</a>
    </div>
  </main>
</body>
</html>
